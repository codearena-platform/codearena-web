# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# Rebuild the affected app after changing any of them.

# Gateway WebSocket base URL. Use wss:// in production; ws:// is fine for local dev.
NEXT_PUBLIC_WS_URL=ws://localhost:8080
# Match ID subscribed to by Bot Studio. Encoded before being placed in the URL.
NEXT_PUBLIC_MATCH_ID=demo-match-001

# Dashboard stream URL. Falls back to NEXT_PUBLIC_WS_URL + /ws when unset.
NEXT_PUBLIC_DASHBOARD_WS_URL=ws://localhost:8080/ws

# Common mount point. Set the same value when building each app behind a proxy
# (for example /arena, /bot or an empty string at the root).
NEXT_PUBLIC_BASE_PATH=

# Home link used by the shared Nav. Use an absolute URL for a separate domain.
NEXT_PUBLIC_PLATFORM_URL=/

# Cross-app links. Absolute URLs are kept as-is; root-relative paths are
# prefixed by next/link with NEXT_PUBLIC_BASE_PATH.
NEXT_PUBLIC_ARENA_URL=/arena
NEXT_PUBLIC_BOT_URL=/bot
NEXT_PUBLIC_DASHBOARD_URL=/dashboard
